    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "heic2any": "^0.0.4",
    "next": "16.0.7",
    "next-export-optimize-images": "^4.7.0",
    "react": "19.2.0",
    "react-calendar": "^6.0.0",
    "react-dom": "19.2.0",
    "three": "^0.186.0"
